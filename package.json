{
  "name": "@phun-ky/cardinal",
  "version": "3.0.6",
  "description": "A set of JavaScript functions that gives you the cardinal direction based on degrees",
  "keywords": [
    "cardinal",
    "direction",
    "cardinal direction",
    "compass",
    "degrees"
  ],
  "homepage": "https://github.com/phun-ky/cardinal#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/cardinal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/cardinal.git"
  },
  "funding": "https://github.com/phun-ky/cardinal?sponsor=1",
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander@phun-ky.net>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/cardinal.d.ts",
      "default": "./dist/cardinal.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/cardinal.js",
  "types": "./dist/cardinal.d.ts",
  "files": [
    "/dist/cardinal.js",
    "/dist/cardinal.js.map",
    "/dist/cardinal.d.ts",
    "/CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "bestpractices:url": "node scripts/bestpractices-url.mjs",
    "build": "npm run clean && npm run rollup",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "clean": "rm -rf dist dts",
    "commit": "npx git-cz",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors && node scripts/readme-api.mjs --check",
    "docs:gen": "typedoc && node scripts/readme-api.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "prerollup:dev": "npm run clean",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "release": "release-it",
    "release:dry-run": ".github/scripts/should-release.sh && release-it --ci --dry-run --github.release=false --no-npm.publish --no-git.requireCleanWorkingDir --no-git.requireUpstream",
    "rollup": "rollup -c",
    "rollup:dev": "rollup -c -w",
    "style:format": "eslint . --fix",
    "style:format-check": "prettier --check '**/*.{json,yml,yaml}'",
    "style:lint": "eslint .",
    "test": "node --import tsx --test --enable-source-maps 'src/**/__tests__/**/*.ts'",
    "test:ci": "node --import tsx --test --enable-source-maps --experimental-test-coverage --test-coverage-include='src/**/*.ts' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-lines=99 --test-coverage-functions=100 --test-coverage-branches=100 --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout 'src/**/__tests__/**/*.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^24.19.2",
    "cobertura": "^1.0.1",
    "eslint": "^10.0.0",
    "eslint-config-phun-ky": "^2.0.10",
    "git-cz": "^4.9.0",
    "globals": "^17.13.0",
    "prettier": "^3.8.0",
    "publint": "^0.3.25",
    "release-it": "^21.1.1",
    "remark-github": "^12.0.0",
    "remark-toc": "^9.0.0",
    "rollup": "^4.12.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-typescript2": "^0.37.0",
    "tsx": "^4.7.1",
    "typedoc": "^0.28.3",
    "typedoc-plugin-markdown": "^4.6.3",
    "typedoc-plugin-mdn-links": "^5.0.1",
    "typedoc-plugin-remark": "^2.0.0",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^7.0.2",
    "unified-prettier": "^2.0.1"
  },
  "engines": {
    "node": ">=22.9.0",
    "npm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.3"
    },
    "release-it": {
      "undici": "^7.30.1"
    }
  }
}
